# Copiez ce fichier en .env en local, ou collez TOUT ce contenu dans le secret GitHub ENV_FILE.
# Ne commitez jamais le vrai .env (clés, mots de passe).

# --- Déploiement (utilisé par scripts/push.sh et GitHub Actions) ---
SERVER_IP=82.165.150.150
SERVER_USER=root
SERVER_PASS=
DEST_DIR=/home/TAKYMED
PORT=3500
DOMAIN=dev.takymed.com

# --- Application ---
PING_MESSAGE="TAKYMED API is running"
DB_PATH=./bd.sqlite
NODE_ENV=production

# --- Frontend (build Vite) ---
VITE_PUBLIC_BUILDER_KEY=__BUILDER_PUBLIC_KEY__

# --- IA médicaments ---
GEMINI_API_KEY=

# --- Notifications push (optionnel) ---
FCM_SERVER_KEY=

