# Dev local web (npm run dev) + preview type IONOS (npm run preview:web)
PORT=3500

# Cible du proxy en mode preview (SPA statique comme sur takymed.com)
# Utilise le backend distant si vous ne lancez pas l'API en local.
API_PROXY_TARGET=http://dev.takymed.com:3500

# Port du serveur preview (build production testé localement)
WEB_PREVIEW_PORT=4173
