RewriteEngine On
RewriteBase /

# Redirection explicite des requêtes /api vers le proxy PHP
RewriteRule ^api/(.*)$ /api_proxy.php?path=$1 [QSA,L]

# Fichiers statiques existants
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Routage React (SPA)
RewriteRule ^ index.html [L]
