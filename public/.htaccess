RewriteEngine On
RewriteBase /

# 1. Redirection explicite des requêtes /api vers le proxy PHP avec path
RewriteRule ^api/(.*)$ /api_proxy.php?path=$1 [QSA,L]

# 2. Fichiers statiques existants
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3. React Router
RewriteRule ^ index.html [L]
